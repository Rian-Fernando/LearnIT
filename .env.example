# ---------------------------------------------------------------------------
# learnIT — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Public origin of the deployment (used for absolute URLs and SSO callbacks).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# 32+ byte random string used to sign session JWTs.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-value-at-least-32-chars"

# Session lifetime in seconds (default: 8 hours — one Help Desk shift).
SESSION_MAX_AGE="28800"

# ---------------------------------------------------------------------------
# Identity provider
# ---------------------------------------------------------------------------
# Which auth adapter to use: "mock" | "oidc"
#   mock — local development / portfolio demo. Sign in as a seeded persona.
#          Refuses to start when NODE_ENV=production unless
#          AUTH_ALLOW_MOCK_IN_PRODUCTION is explicitly "true".
#   oidc — Adelphi's approved identity provider (see docs/authentication.md).
AUTH_PROVIDER="mock"

# Escape hatch for hosting the public portfolio build with mock personas.
# Leave unset for any deployment holding real Help Desk content.
AUTH_ALLOW_MOCK_IN_PRODUCTION=""

# --- OIDC settings (only required when AUTH_PROVIDER="oidc") ---------------
# Supplied by Adelphi IT once the application is registered.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# Space-delimited scopes. `openid profile email` is the usual minimum.
OIDC_SCOPES="openid profile email"
# Claim used to derive a learnIT role, plus the values that grant each role.
OIDC_GROUPS_CLAIM="groups"
OIDC_ADMIN_GROUP=""
OIDC_STAFF_GROUP=""

# ---------------------------------------------------------------------------
# Content + persistence
# ---------------------------------------------------------------------------
# Which content adapter backs the platform: "file" | "postgres"
#   file     — versioned content in `content/`. Read-only at runtime; admin
#              screens run in preview mode. Ideal for the public demo.
#   postgres — full read/write CMS with revision history and analytics.
CONTENT_ADAPTER="file"

# Required when CONTENT_ADAPTER="postgres".
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Demo / portfolio mode
# ---------------------------------------------------------------------------
# When "true", only content tagged `visibility: public` is ever served, and
# the app refuses to load the internal content set. This is the flag that makes
# the portfolio deployment safe.
NEXT_PUBLIC_DEMO_MODE="true"
