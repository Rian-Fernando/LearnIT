# ---------------------------------------------------------------------------
# learnIT — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Canonical origin. Every absolute URL — sitemap, canonical tags, OG images,
# OAuth redirect URIs — derives from this, so it must match the domain you
# actually serve from.
NEXT_PUBLIC_SITE_URL="https://learnit.rianfernando.com"

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# 32+ byte random string used to sign session JWTs.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-value-at-least-32-chars"

# Session lifetime in seconds (default: 8 hours — one Help Desk shift).
SESSION_MAX_AGE="28800"

# ---------------------------------------------------------------------------
# Identity providers
# ---------------------------------------------------------------------------
# Comma-separated. More than one may be enabled at once, which is how you move
# from Google to Microsoft without a cutover: run both, then drop the old one.
#
#   mock       Local development / public demo. Sign in as a seeded persona.
#              Refuses to run in production unless AUTH_ALLOW_MOCK_IN_PRODUCTION
#              is set, which additionally forces NEXT_PUBLIC_DEMO_MODE on.
#   google     Google / Google Workspace.
#   microsoft  Microsoft Entra ID (Office 365).
#   oidc       Any other conformant OpenID Connect provider.
AUTH_PROVIDERS="mock"

# Escape hatch for hosting the public portfolio build with mock personas.
# Leave unset for any deployment holding real Help Desk content.
AUTH_ALLOW_MOCK_IN_PRODUCTION=""

# --- Google ----------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   Application type:  Web application
#   Redirect URI:      https://<your-domain>/api/auth/callback?provider=google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft -------------------------------------------------------------
# Entra admin centre → App registrations → New registration
#   Redirect URI (Web): https://<your-domain>/api/auth/callback?provider=microsoft
#   Add a client secret under Certificates & secrets
# Tenant id, or "common" for any Microsoft account. Prefer a specific tenant.
MICROSOFT_TENANT_ID="common"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- Generic OIDC (only if AUTH_PROVIDERS includes "oidc") ------------------
OIDC_DISPLAY_NAME="single sign-on"
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email"

# ---------------------------------------------------------------------------
# Who is authorised
# ---------------------------------------------------------------------------
# At least one rule is required when a real provider is enabled, otherwise
# every sign-in would be refused. Resolution order: admin group, admin email,
# staff group, staff email, allowed domain. No match means access is refused.

# Group membership. The right mechanism for Entra ID, which can emit a groups
# claim. Google Workspace does NOT put groups in the ID token — use the email
# and domain allowlists below for Google.
AUTH_GROUPS_CLAIM="groups"
AUTH_ADMIN_GROUP=""
AUTH_STAFF_GROUP=""

# Email allowlists. Comma-separated. Only matched against verified addresses.
AUTH_ADMIN_EMAILS=""
AUTH_STAFF_EMAILS=""

# Domains granted staff access. Comma-separated, e.g. "adelphi.edu".
# Checked against Google's verified `hd` claim, falling back to the verified
# email domain. Also used as the Google account-chooser hint.
AUTH_ALLOWED_DOMAINS=""

# Entra tenant ids permitted to sign in. Comma-separated. When set, this is a
# hard gate applied before any role is considered.
AUTH_ALLOWED_TENANTS=""

# ---------------------------------------------------------------------------
# Content + persistence
# ---------------------------------------------------------------------------
# Which content adapter backs the platform: "file" | "postgres"
#   file     — versioned content in `src/content/`. Read-only at runtime; the
#              admin console runs in preview mode. Ideal for the public demo.
#   postgres — full read/write CMS with revision history and analytics.
CONTENT_ADAPTER="file"

# Required when CONTENT_ADAPTER="postgres".
# On Vercel: Storage → Neon → connect. This is injected automatically.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Demo / portfolio mode
# ---------------------------------------------------------------------------
# When "true", only content tagged `visibility: public` is ever served, applied
# before any role check. This is the flag that makes the portfolio deployment
# safe — an authenticated demo persona still cannot reach internal content.
NEXT_PUBLIC_DEMO_MODE="true"
