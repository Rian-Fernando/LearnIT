{
  "name": "learnit",
  "version": "0.1.0",
  "private": true,
  "description": "Onboarding, training, and operational knowledge platform for the Adelphi University Help Desk.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx scripts/validate-content.ts",
    "check": "npm run lint && npm run typecheck && npm run content:validate"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lenis": "^1.1.18",
    "lucide-react": "^1.31.0",
    "minisearch": "^7.1.1",
    "next": "^15.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.172.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.172.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
